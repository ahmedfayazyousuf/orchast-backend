# Copy to .env and fill in the three Supabase values. See README.md.
# Generate COOKIE_SECRET with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"

NODE_ENV=development
PORT=1918
APP_URL=http://localhost:1918
FRONTEND_URL=http://localhost:1818

COOKIE_SECRET=replace-me-with-a-random-string-at-least-32-characters
# Set this in production when the app and API are subdomains of one site, for example .orchast.com
COOKIE_DOMAIN=

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Leave empty on a new project. Paste the legacy JWT secret only if GET /auth/me
# returns 401 after a successful Google or Microsoft redirect.
SUPABASE_JWT_SECRET=
